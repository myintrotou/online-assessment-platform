# Copy to .env.local for local development, or set these as environment variables on your host.
# The Neon values come from `neon env pull` (run automatically by `neon link` / `neon checkout`).

# --- Database (Neon / Lakebase Postgres) ---
# Pooled endpoint (hostname has -pooler): used for normal app traffic.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct endpoint (no -pooler): used for EF Core migrations and the startup schema check.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- JWT ---
JWT__KEY=replace-with-a-random-string-at-least-32-characters-long
JWT__ISSUER=assessment-platform
JWT__AUDIENCE=assessment-platform

# --- AI (Google Gemini) ---
AI__PROVIDER=Gemini            # or "Stub" to run with no key
AI__MODEL=gemini-3.6-flash
AI__APIKEY=your-gemini-api-key-from-aistudio.google.com

# --- CORS: the frontend origin(s) allowed to call this API ---
CORS__ORIGINS__0=http://localhost:4200
# CORS__ORIGINS__1=https://your-frontend.pages.dev
